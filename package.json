{
  "name": "wanikani-advisor",
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wanikani-advisor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "keywords": [
    "wanikani",
    "kanji",
    "japanese",
    "study"
  ],
  "author": "",
  "license": "ISC",
  "description": "AI-powered study advisor for WaniKani - analyzes your mistakes and provides personalized kanji/vocabulary advice",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.29.2"
  }
}
